{
  "manifest_version": 3,
  "name": "IDM Clone Integration Module",
  "version": "1.1.0",
  "description": "Browser integration extension for IDM Clone with media stream sniffer and desktop acceleration",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "storage",
    "webRequest",
    "notifications",
    "downloads",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IDM Clone"
  }
}
